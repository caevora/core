# ✅ Keep the exported profile file
!core.xml

# 📝 Ignore Git logs
gitlog.txt

# 🪟 Ignore Windows system files
Thumbs.db
Desktop.ini

# ⚙️ Ignore auto-generated batch files
exportGit.bat

# ❌ Ignore contents of specific subfolders
Achaean System/system/libs/backup/*
!Achaean System/system/libs/backup/
!Achaean System/system/libs/backup/.gitkeep

Achaean System/system/libs/json/*
!Achaean System/system/libs/json/
!Achaean System/system/libs/json/.gitkeep

Achaean System/system/libs/ndb/*
!Achaean System/system/libs/ndb/
!Achaean System/system/libs/ndb/.gitkeep

# ❌ Ignore the entire combat directory (your personal logic)
Achaean System/combat/

# 🗃️ Ignore temporary and generated file types
*.bak
*.corrupt
*.zip
*.tmp

# ✅ But explicitly ignore JSONs only in system/libs (most important)
# (Prevents accidental global ignoring if others are tracked elsewhere)
!/Achaean System/system/libs/
Achaean System/system/libs/*.json

# ignore ALL json files
**/*.json

# ❌ Ignore user-specific Mudlet files
*.map
*.profile

# ❌ Compiled Lua outputs
luac.out

# ❌ luarocks build artifacts
*.src.rock
*.tar.gz

# ❌ Common binary and object formats
*.o
*.os
*.ko
*.obj
*.elf
*.lib
*.a
*.la
*.lo
*.def
*.exp
*.dll
*.so
*.so.*
*.dylib
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex
*.pch
*.gch
